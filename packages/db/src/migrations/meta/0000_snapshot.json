          "primaryKey": false,
          "notNull": false
        },
        "startTime": {
          "name": "startTime",
          "type": "time",
          "primaryKey": false,
          "notNull": false
        },
        "endTime": {
          "name": "endTime",
          "type": "time",
          "primaryKey": false,
          "notNull": false
        },
        "availabilityStatus": {
          "name": "availabilityStatus",
          "type": "varchar(50)",
          "primaryKey": false,
          "notNull": false
        },
        "appointmentId": {
          "name": "appointmentId",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "bookingReason": {
          "name": "bookingReason",
          "type": "varchar(500)",
          "primaryKey": false,
          "notNull": false
        },
        "patientDui": {
          "name": "patientDui",
          "type": "varchar(10)",
          "primaryKey": false,
          "notNull": false
        },
        "firstName": {
          "name": "firstName",
          "type": "varchar(100)",
          "primaryKey": false,
          "notNull": false
        },
        "lastName": {
          "name": "lastName",
          "type": "varchar(100)",
          "primaryKey": false,
          "notNull": false
        },
        "whatsappPhone": {
          "name": "whatsappPhone",
          "type": "varchar(20)",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    se.id                 AS \"eventId\",\n    se.\"doctorId\",\n    se.\"eventDate\",\n    se.\"startTime\",\n    se.\"endTime\",\n    se.\"availabilityStatus\",\n    ma.id                 AS \"appointmentId\",\n    ma.\"bookingReason\",\n    p.dui                 AS \"patientDui\",\n    p.\"firstName\",\n    p.\"lastName\",\n    p.\"whatsappPhone\"\n  FROM \"ScheduleEvents\" se\n  LEFT JOIN \"MedicalAppointments\" ma ON ma.\"eventId\" = se.id\n  LEFT JOIN \"Patients\" p             ON p.dui = ma.\"patientDui\"\n  WHERE se.\"eventType\" = 'appointment'\n",
      "name": "DailyScheduleView",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.PatientFullRecordView": {
      "columns": {
        "dui": {
          "name": "dui",
          "type": "varchar(10)",
          "primaryKey": false,
          "notNull": false
        },
        "firstName": {
          "name": "firstName",
          "type": "varchar(100)",
          "primaryKey": false,
          "notNull": false
        },
        "lastName": {
          "name": "lastName",
