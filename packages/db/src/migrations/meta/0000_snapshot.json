        },
        "whatsappPhone": {
          "name": "whatsappPhone",
          "type": "varchar(20)",
          "primaryKey": false,
          "notNull": false
        },
        "insurerName": {
          "name": "insurerName",
          "type": "varchar(200)",
          "primaryKey": false,
          "notNull": false
        },
        "coverageType": {
          "name": "coverageType",
