          "notNull": false
        },
        "recordId": {
          "name": "recordId",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "bloodType": {
          "name": "bloodType",
          "type": "varchar(5)",
          "primaryKey": false,
          "notNull": false
        },
        "knownAllergies": {
          "name": "knownAllergies",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "familyHistory": {
          "name": "familyHistory",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "chronicConditions": {
          "name": "chronicConditions",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "recordOpenedAt": {
          "name": "recordOpenedAt",
          "type": "date",
          "primaryKey": false,
          "notNull": false
        },
        "lastConsultationId": {
          "name": "lastConsultationId",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "lastDiagnosis": {
          "name": "lastDiagnosis",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "lastTreatment": {
          "name": "lastTreatment",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "lastVisitDate": {
          "name": "lastVisitDate",
          "type": "timestamp",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    p.dui,\n    p.\"firstName\",\n    p.\"lastName\",\n    p.\"birthDate\",\n    p.\"whatsappPhone\",\n    mi.\"insurerName\",\n    mi.\"coverageType\",\n    mr.id                      AS \"recordId\",\n    mr.\"bloodType\",\n    mr.\"knownAllergies\",\n    mr.\"familyHistory\",\n    mr.\"chronicConditions\",\n    mr.\"openedAt\"              AS \"recordOpenedAt\",\n    cc.id                      AS \"lastConsultationId\",\n    cc.\"mainDiagnosis\"         AS \"lastDiagnosis\",\n    cc.\"prescribedTreatment\"   AS \"lastTreatment\",\n    ma.\"bookedAt\"              AS \"lastVisitDate\"\n  FROM \"Patients\" p\n  LEFT JOIN \"MedicalInsurances\" mi ON mi.id = p.\"insuranceId\"\n  LEFT JOIN \"MedicalRecords\"    mr ON mr.\"patientDui\" = p.dui\n  LEFT JOIN LATERAL (\n    SELECT cc.*, ma.\"bookedAt\"\n    FROM \"ClinicalConsultations\" cc\n    JOIN \"MedicalAppointments\"   ma ON ma.id = cc.\"appointmentId\"\n    WHERE cc.\"recordId\" = mr.id\n    ORDER BY ma.\"bookedAt\" DESC\n    LIMIT 1\n  ) cc ON true\n  LEFT JOIN \"MedicalAppointments\" ma ON ma.id = cc.\"appointmentId\"\n",
      "name": "PatientFullRecordView",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
