  "views": {
    "public.DailyScheduleView": {
      "columns": {
        "eventId": {
          "name": "eventId",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "doctorId": {
          "name": "doctorId",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "eventDate": {
